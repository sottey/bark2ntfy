# ntfy server and topic for every forwarded Bark notification.
NTFY_URL=https://ntfy.example.com
NTFY_TOPIC=my-notification-topic

# Required. This file is ignored by Git once copied to .env.
NTFY_TOKEN=tk_replace_with_a_real_ntfy_access_token

# Docker Compose publishes only to loopback by default. Change this only when
# an external firewall, VPN, or authenticated reverse proxy protects the port.
BARK2NTFY_BIND_ADDRESS=127.0.0.1
BARK2NTFY_HOST_PORT=8080
